<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Name }} Founder Engineer CV</title>
  <style>
    :root {
      --ink: #101820;
      --muted: #5d6870;
      --accent: #c94f1b;
      --accent-soft: #f5dfcc;
      --paper: #fffaf1;
      --panel: rgba(255, 253, 248, 0.9);
      --line: #1f2f3a;
    }
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      color: var(--ink);
      background:
        radial-gradient(circle at 16% 10%, rgba(201, 79, 27, 0.18), transparent 28%),
        linear-gradient(135deg, #fffaf1 0%, #f3eadb 100%);
      font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
      line-height: 1.5;
    }
    main {
      max-width: 980px;
      margin: 36px auto;
      padding: 36px;
      background: var(--panel);
      border: 1px solid rgba(31, 47, 58, 0.18);
      box-shadow: 0 24px 70px rgba(16, 24, 32, 0.12);
    }
    header {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(240px, 0.65fr);
      gap: 28px;
      border-bottom: 3px solid var(--line);
      padding-bottom: 24px;
      margin-bottom: 26px;
    }
    h1 {
      margin: 0 0 18px;
      font-size: clamp(42px, 7vw, 78px);
      line-height: 0.9;
      letter-spacing: -0.075em;
    }
    h2 {
      margin: 30px 0 12px;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--accent);
    }
    p {
      margin: 0 0 12px;
    }
    a {
      color: inherit;
      text-decoration-color: var(--accent);
      text-underline-offset: 3px;
    }
    ul {
      margin: 10px 0 0 18px;
      padding: 0;
    }
    li {
      margin: 6px 0;
    }
    .summary {
      max-width: 680px;
      font-size: 18px;
    }
    .contact-card {
      align-self: end;
      padding: 16px;
      background: var(--accent-soft);
      border-left: 5px solid var(--accent);
      font-size: 14px;
    }
    .contact-card div {
      margin: 0 0 6px;
    }
    .contact-card div:last-child {
      margin-bottom: 0;
    }
    .signal {
      margin-top: 14px;
      color: var(--accent);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.13em;
      font-size: 11px;
    }
    .item {
      padding: 16px 0;
      border-top: 1px solid rgba(31, 47, 58, 0.18);
      break-inside: avoid;
    }
    .item:first-of-type {
      border-top: 0;
      padding-top: 0;
    }
    .item-head {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      align-items: baseline;
    }
    .title {
      font-weight: 800;
      font-size: 17px;
    }
    .meta {
      color: var(--muted);
      font-size: 13px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .card {
      padding: 16px;
      background: rgba(245, 223, 204, 0.62);
      border: 1px solid rgba(201, 79, 27, 0.22);
      border-left: 5px solid var(--accent);
      break-inside: avoid;
    }
    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .skills li {
      margin: 0;
      padding: 5px 9px;
      background: #fff3e6;
      border: 1px solid rgba(31, 47, 58, 0.14);
      border-radius: 999px;
      font-size: 13px;
    }
    @media (max-width: 760px) {
      body {
        background: var(--paper);
      }
      main {
        margin: 0;
        padding: 24px;
        border: 0;
        box-shadow: none;
      }
      header, .grid {
        grid-template-columns: 1fr;
      }
      .item-head {
        display: block;
      }
    }
    @media print {
      body {
        background: #fff;
      }
      main {
        max-width: none;
        margin: 0;
        padding: 0;
        border: 0;
        box-shadow: none;
      }
      a {
        text-decoration: none;
      }
      .contact-card, .card, .skills li {
        background: #fff;
      }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <div>
        <h1>{{ .Name }}</h1>
{{ if .Summary }}<p class="summary">{{ .Summary }}</p>{{ end }}
        <div class="signal">Product judgment · systems execution · operational context</div>
      </div>
      <aside class="contact-card" aria-label="Contact">
{{ if .Contact.Email }}<div><strong>Email</strong><br><a href="mailto:{{ .Contact.Email }}">{{ .Contact.Email }}</a></div>{{ end }}
{{ if .Contact.Phone }}<div><strong>Phone</strong><br>{{ .Contact.Phone }}</div>{{ end }}
{{ if .Contact.Location }}<div><strong>Location</strong><br>{{ .Contact.Location }}</div>{{ end }}
{{ range .Links }}<div><strong>{{ .Label }}</strong><br><a href="{{ .URL }}">{{ .URL }}</a></div>{{ end }}
      </aside>
    </header>
{{ if .Experience }}
    <section>
      <h2>Experience</h2>
{{ range .Experience }}
      <article class="item">
        <div class="item-head">
          <div>
            <div class="title">{{ .Title }} · {{ .Company }}</div>
{{ if .Location }}<div class="meta">{{ .Location }}</div>{{ end }}
          </div>
          <div class="meta">{{ .Start }}&ndash;{{ .End }}</div>
        </div>
        <ul>{{ range .Bullets }}<li>{{ .Text }}</li>{{ end }}</ul>
      </article>
{{ end }}
    </section>
{{ end }}
{{ if .Projects }}
    <section>
      <h2>Selected Builds</h2>
      <div class="grid">
{{ range .Projects }}
        <article class="card">
          <div class="title">{{ .Name }}</div>
{{ if .Description }}<p class="meta">{{ .Description }}</p>{{ end }}
          <ul>{{ range .Bullets }}<li>{{ .Text }}</li>{{ end }}</ul>
        </article>
{{ end }}
      </div>
    </section>
{{ end }}
{{ if .Skills }}
    <section>
      <h2>Skills</h2>
      <ul class="skills">{{ range .Skills }}<li>{{ . }}</li>{{ end }}</ul>
    </section>
{{ end }}
{{ if .Education }}
    <section>
      <h2>Education</h2>
{{ range .Education }}
      <article class="item">
        <div class="item-head">
          <div class="title">{{ .Degree }}</div>
          <div class="meta">{{ .Start }}&ndash;{{ .End }}</div>
        </div>
        <div class="meta">{{ .Institution }}</div>
      </article>
{{ end }}
    </section>
{{ end }}
  </main>
</body>
</html>
